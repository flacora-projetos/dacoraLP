# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# META CONVERSIONS API
# The auth token from Meta Events Manager
META_ACCESS_TOKEN=""
# The Pixel ID to send events to
META_PIXEL_ID=""
# Optional: test code for Meta Events Manager (e.g., TEST4321)
META_TEST_CODE=""

# =====================================================================
# PAINEL DE APROVAÇÃO DE RELATÓRIOS (/painel-de-relatorios)
#
# Banco: projeto Supabase "Dácora Reports" — NÃO é o mesmo projeto da
# SmartBio. Base de usuários e URL de retorno são separadas.
#
# REGRA QUE NÃO PODE SER QUEBRADA: tudo que começa com VITE_ é embutido
# no pacote enviado ao navegador e pode ser lido por qualquer visitante.
# Endereço e chave pública do Supabase são públicos por natureza e podem
# estar aí. A lista de quem pode entrar no painel — e, no futuro, a chave
# de serviço do banco — NÃO PODEM ganhar o prefixo VITE_ em hipótese
# nenhuma.
# =====================================================================

# Público (vai para o navegador, e tudo bem)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Públicos por definição: identificam o projeto no Google Picker, sem conceder acesso.
VITE_DATA_HUB_GOOGLE_PICKER_API_KEY=""
VITE_DATA_HUB_GOOGLE_PICKER_APP_ID=""

# Só do servidor. Separe por vírgula. Sem prefixo VITE_.
# Se ficar vazia, ninguém entra — o painel falha fechado de propósito.
PAINEL_EMAILS_AUTORIZADOS=""

# Só do servidor, e ainda NÃO é usada na P0: entra na P1, quando o painel
# passar a ler a tabela de relatórios. A RLS está ligada sem política de
# propósito, então esta é a única chave que enxerga a tabela.
# NUNCA com prefixo VITE_.
# SUPABASE_SERVICE_ROLE_KEY=""

# RA2 — somente no handler Vercel da revisão assistida. Nunca use VITE_.
# Sem as duas variáveis a caneta falha fechada; não há fallback para outro modelo.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL_RA2="claude-sonnet-5"
