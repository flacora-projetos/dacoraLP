{
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    {
      "src": "/img/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(og-image\\.jpg|favicon\\.ico|favicon-32\\.png|apple-touch-icon\\.png|icon-192\\.png|icon-512\\.png)",
      "headers": { "Cache-Control": "public, max-age=604800" },
      "continue": true
    },
    {
      "src": "/(robots\\.txt|sitemap\\.xml|llms\\.txt|site\\.webmanifest)",
      "headers": { "Cache-Control": "public, max-age=3600" },
      "continue": true
    },
    {
      "src": "/relatorios/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "Referrer-Policy": "no-referrer",
        "Cache-Control": "private, no-store, no-cache, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/painel-de-relatorios(/.*)?",
      "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/proposta-landing-page/?", "dest": "/proposta-landing-page.html" },
    { "src": "/politica-de-privacidade/?", "dest": "/politica-de-privacidade.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
